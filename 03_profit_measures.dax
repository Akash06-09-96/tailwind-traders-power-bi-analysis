// Profit and margin measures used on the Profit Performance Overview page.

Profit in USD =
'Sales in USD'[Net Revenue USD]
    - 'Sales in USD'[Total Tax USD]

// Measures the remaining amount after subtracting tax from net revenue.

Yearly Profit Margin =
DIVIDE(
    SUM('Sales in USD'[Profit in USD]),
    SUM('Sales in USD'[Net Revenue USD])
)

// DIVIDE() is used instead of the / operator for safe divide-by-zero handling.

Quarterly Profit =
CALCULATE(
    SUM('Sales in USD'[Profit in USD]),
    DATESQTD(CalendarTable[Date])
)

// Combines CALCULATE() and DATESQTD() to evaluate cumulative profit
// for the current quarter.

YTD Profit =
TOTALYTD(
    SUM('Sales in USD'[Profit in USD]),
    CalendarTable[Date]
)

// Enables cumulative profit analysis from the start of the year
// through the selected date.
